{
  "name": "series_game",
  "version": "1.0.0",
  "description": "One Life Relay — an open-source community arcade game with user-created HTML stages.",
  "main": "game.js",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "test": "node --test relay-tools/tests/*.test.js",
    "test:api": "npm test --prefix relay-api",
    "build:pages": "node relay-tools/scripts/build_pages_site.js --out _site",
    "relay:sync-registry": "node relay-tools/scripts/sync_registry.js",
    "relay:create": "node relay-tools/scripts/create_stage.js",
    "relay:check": "node relay-tools/scripts/check_stage.js",
    "relay:check-difficulty": "node relay-tools/scripts/check_difficulty_curve.js",
    "relay:host-check": "node relay-tools/scripts/check_host_flow.js",
    "relay:publish": "node relay-tools/scripts/publish_stage.js",
    "relay:pr-review": "node relay-tools/scripts/pr_review.js",
    "relay:analyze-playability": "node relay-tools/scripts/analyze_playability.js"
  },
  "keywords": [
    "open-source",
    "web-game",
    "html5-game",
    "arcade-game",
    "community-game",
    "ai-assisted-development",
    "playwright",
    "github-actions"
  ],
  "author": "Collin Jung",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "dependencies": {
    "playwright": "^1.58.2"
  }
}
